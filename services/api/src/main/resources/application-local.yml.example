# 复制为 application-local.yml 后填写真实值，该文件已被 .gitignore 忽略
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/picklight?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: 改成你自己的密码
    driver-class-name: com.mysql.cj.jdbc.Driver

app:
  jwt:
    secret: 改成至少 32 位的随机字符串
  media:
    upload-dir: ./uploads
