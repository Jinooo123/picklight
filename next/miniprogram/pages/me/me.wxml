<view class="page"><view class="eyebrow">YOUR PERSONAL COLLECTION</view><view class="heading">把日子，慢慢收藏。</view><view wx:if="{{user}}"><view class="hero"><view class="card-title">{{user.nickname}}</view><view class="muted">{{user.username}} · {{total}} 个片刻</view></view><view class="row"><button class="secondary" bindtap="toggle">账号与密码</button><button class="secondary" bindtap="logout">退出登录</button></view><view class="card" wx:if="{{passwordOpen}}"><input data-key="oldPassword" bindinput="input" password placeholder="原密码"/><input data-key="password" bindinput="input" password placeholder="新密码，至少8位"/><button bindtap="changePassword">保存并重新登录</button></view><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="card-title">{{item.title}}</view><view class="body">{{item.body}}</view><view class="meta"><text>{{item.date}}</text><text>{{item.status==='HIDDEN'?'已下架':'已发布'}}</text></view><view class="row"><button wx:if="{{item.status==='PUBLISHED'}}" class="secondary" bindtap="edit" data-id="{{item.id}}">编辑</button><button class="danger" bindtap="remove" data-id="{{item.id}}">删除</button></view></view><view class="empty" wx:if="{{!items.length}}">还没有记录，今天就开始吧。</view></view><view wx:else class="empty">登录后，查看属于你的回忆。<button bindtap="login">登录 / 注册</button></view></view>
