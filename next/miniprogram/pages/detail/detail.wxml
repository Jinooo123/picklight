<view class="page"><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view><block wx:if="{{post}}"><view class="eyebrow">A MOMENT TO REMEMBER</view><view class="heading">{{post.title}}</view><view class="muted">{{post.author}} · {{post.date}}</view><view class="card"><view class="body">{{post.body}}</view></view><view wx:for="{{post.media}}" wx:key="id"><image wx:if="{{item.type==='image'}}" class="cover" src="{{item.url}}" mode="aspectFit"/><video wx:else class="cover" src="{{item.url}}" controls/></view><view class="tags"><text class="chip" wx:for="{{post.tags}}" wx:key="*this"># {{item}}</text></view><view class="card"><view class="section">给这个片刻打个分</view><view class="muted">{{post.average}} 分 · {{post.ratingCount}} 人评分</view><view class="row" wx:if="{{post.user_id!==userId}}"><button wx:for="{{[1,2,3,4,5]}}" wx:key="*this" bindtap="rate" data-n="{{item}}" disabled="{{busy}}">{{item}}★</button></view><view class="notice" wx:else>不能给自己的内容评分。</view></view><view class="section">片刻回应 · {{total}}</view><input value="{{body}}" bindinput="input" maxlength="500" placeholder="说说让你有共鸣的地方…"/><button bindtap="send" loading="{{busy}}" disabled="{{busy}}">留下回应</button><view class="comment" wx:for="{{comments}}" wx:key="id"><view>{{item.author}}</view><view class="body">{{item.body}}</view><button wx:if="{{item.user_id===userId||role==='ADMIN'}}" class="secondary" data-id="{{item.id}}" bindtap="remove">删除回应</button></view></block></view>
