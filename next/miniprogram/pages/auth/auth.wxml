<view class="page"><view class="eyebrow">WELCOME TO MOMENT</view><view class="heading">{{register?'故事，从这里开始。':'欢迎回到，片刻。'}}</view><view class="muted">登录后，把今天留给未来的自己。</view><view class="field"><view class="label">账号</view><input data-key="username" bindinput="input" maxlength="20" placeholder="3-20 位字母、数字或下划线"/></view><view class="field" wx:if="{{register}}"><view class="label">昵称</view><input data-key="nickname" bindinput="input" maxlength="20" placeholder="怎么称呼你？"/></view><view class="field"><view class="label">密码</view><input data-key="password" bindinput="input" password maxlength="64" placeholder="至少 8 位"/></view><view class="error" wx:if="{{error}}">{{error}}</view><button bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{register?'创建账号':'登录片刻'}}</button><button class="secondary" bindtap="toggle">{{register?'已有账号？去登录':'第一次来？创建账号'}}</button></view>
