<view class="page"><view class="eyebrow">CAPTURE THE ORDINARY</view><view class="heading">今天，想留下什么？</view><view class="field"><view class="label">给片刻起个名字</view><input value="{{title}}" data-key="title" bindinput="input" maxlength="60" placeholder="下课以后，去看一场日落"/></view><view class="field"><view class="label">此刻的故事</view><textarea value="{{body}}" data-key="body" bindinput="input" maxlength="2000" placeholder="不用写得很特别，真实就很好。"/></view><button class="secondary" bindtap="choose" loading="{{uploading}}" disabled="{{uploading||media.length>=9}}">添加图片 / 视频</button><view class="notice">JPEG、PNG ≤10MB，MP4 ≤30MB；最多9张图片或1段视频。</view><view wx:for="{{media}}" wx:key="id"><image wx:if="{{item.type==='image'}}" class="cover" src="{{item.url}}" mode="aspectFit"/><video wx:else class="cover" src="{{item.url}}" controls/><button class="secondary" bindtap="remove" data-index="{{index}}">移除</button></view><view class="field"><view class="label">标签</view><input value="{{tags}}" data-key="tags" bindinput="input" placeholder="校园，光影（最多5个）"/></view><view class="field"><view class="label">参与主题</view><picker range="{{topics}}" range-key="title" value="{{topicIndex}}" bindchange="topic">{{topics[topicIndex].title}}</picker></view><view class="error" wx:if="{{error}}">{{error}}</view><button bindtap="save" loading="{{busy}}" disabled="{{busy||uploading}}">{{id?'保存修改':'发布这个片刻'}}</button></view>
